{
  "name": "foxpage-component-boilerplate",
  "version": "0.1.0",
  "private": true,
  "foxpage": {
    "group": "your-group-name"
  },
  "scripts": {
    "init": "npm run boot && lerna run build",
    "boot": "npm install",
    "vite": "cross-env STORYBOOK_BUILDER=vite npm start",
    "start": "storybook dev -p 55555",
    "release:v": "lerna version",
    "release:p": "npm run boot && lerna publish from-git",
    "release": "npm run release:v && npm run release:p",
    "build:foxpage": "foxpage build --foxpage-root",
    "build:umd": "foxpage build --umd-root",
    "build:cjs": "foxpage build --cjs-root",
    "package:new": "foxpage package new --template package-templates/base-template --formate",
    "package:new-ssr": "foxpage package new --template package-templates/base-template-ssr --formate",
    "package:select": "foxpage package new --templates package-templates/ --formate",
    "commit": "git-cz",
    "lint": "eslint --cache --cache-location=.cache/eslint --ext .ts,.tsx --report-unused-disable-directives packages/",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest",
    "test:update": "npm run test -- --updateSnapshot",
    "test:coverage": "npm run test -- --coverage --json --outputFile=./coverage/test-result.json",
    "build-storybook": "storybook build"
  },
  "workspaces": [
    "packages/*"
  ],
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": [
      "npm run lint:fix",
      "git add"
    ],
    "*.ts": [
      "npm run lint:fix",
      "git add"
    ],
    "*.tsx": [
      "npm run lint:fix",
      "git add"
    ]
  },
  "dependencies": {
    "@foxpage/foxpage-component-context": "^0.1.10",
    "react": "^16.14.0",
    "react-dom": "^16.14.0"
  },
  "eslintIgnore": [
    "node_modules",
    "examples",
    "dist",
    "lib",
    "es",
    "config",
    "babel.config.js",
    "jest.config.js",
    "*.js"
  ],
  "devDependencies": {
    "@foxpage/eslint-config-foxpage-component": "^0.2.0",
    "@foxpage/foxpage-cli": "^3.0.0",
    "@foxpage/foxpage-component-babel-preset": "^0.2.0",
    "@foxpage/foxpage-component-editor-storybook-addon": "^0.5.0",
    "@foxpage/foxpage-component-editor-widgets": "^0.6.3",
    "@foxpage/foxpage-component-jest-preset": "^0.1.12",
    "@foxpage/foxpage-component-storybook-addon": "^0.3.1",
    "@foxpage/foxpage-component-storybook-preset": "^0.5.8",
    "@foxpage/foxpage-component-webpack": "^0.4.0",
    "@storybook/addon-actions": "^8.4.0",
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/addon-links": "^8.4.0",
    "@storybook/addon-webpack5-compiler-babel": "^3.0.0",
    "@storybook/components": "^8.4.0",
    "@storybook/manager-api": "^8.4.0",
    "@storybook/preview-api": "^8.4.0",
    "@storybook/react": "^8.4.0",
    "@storybook/react-webpack5": "^8.4.0",
    "@types/jest": "^26.0.24",
    "@types/react": "^16.14.8",
    "@types/react-dom": "^16.9.13",
    "cross-env": "^7.0.3",
    "cssnano": "^5.1.14",
    "eslint-plugin-prettier": "^3.1.0",
    "git-cz": "^4.7.6",
    "husky": "^4.3.8",
    "jest": "^26.4.2",
    "lerna": "^4.0.0",
    "lint-staged": "^9.2.5",
    "storybook": "^8.4.0",
    "typescript": "^4.3.3",
    "webpack": "^5.0.0"
  }
}
